<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.Integer?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.rh.contollers.FactureController">

    <VBox styleClass="dashboard-root" spacing="20">

        <!-- ── En-tête ── -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="📄  Gestion des Factures" styleClass="welcome-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="＋  Ajouter une facture" styleClass="btn-primary" onAction="#onAjouterFacture"/>
            <Button text="📥  Exporter" styleClass="btn-secondary" onAction="#onExporter"/>
        </HBox>

        <!-- ── Filtres / Recherche ── -->
        <HBox spacing="12" alignment="CENTER_LEFT">
            <TextField fx:id="txtRecherche" promptText="🔍  Rechercher une facture..."
                       style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 8 14; -fx-border-color: #F0E6DA; -fx-border-radius: 8;"
                       prefWidth="300"/>
            <ComboBox fx:id="comboFiltreStatut" promptText="Filtrer par statut"
                      style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 4 8; -fx-border-color: #F0E6DA; -fx-border-radius: 8; -fx-pref-height: 36;"/>
            <Button text="Filtrer" styleClass="btn-secondary" onAction="#onFiltrer"/>
            <Button text="Réinitialiser" styleClass="btn-back" onAction="#onReinitialiser"/>
        </HBox>

        <!-- ── Statistiques rapides ── -->
        <HBox spacing="15">
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="5" style="-fx-padding: 12 18;">
                <Label text="Total factures" styleClass="card-label"/>
                <Label fx:id="lblTotalFactures" text="0" styleClass="card-value" style="-fx-font-size: 22px;"/>
            </VBox>
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="5" style="-fx-padding: 12 18; -fx-border-color: #4F6815; -fx-border-width: 2;">
                <Label text="Montant total" styleClass="card-label"/>
                <Label fx:id="lblMontantTotal" text="0,00 DT" styleClass="card-value" style="-fx-font-size: 22px; -fx-text-fill: #4F6815;"/>
            </VBox>
        </HBox>

        <!-- ── Tableau ── -->
        <VBox styleClass="chart-card" VBox.vgrow="ALWAYS" spacing="12">

            <HBox alignment="CENTER_LEFT">
                <Label text="📋  Liste des factures" styleClass="section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <Separator/>

            <TableView fx:id="tableView" prefHeight="450" styleClass="activity-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNumero" prefWidth="150" text="NUMÉRO"/>
                    <TableColumn fx:id="colFournisseur" prefWidth="180" text="FOURNISSEUR"/>
                    <TableColumn fx:id="colMontantHt" prefWidth="120" text="MONTANT HT"/>
                    <TableColumn fx:id="colMontantTva" prefWidth="120" text="TVA"/>
                    <TableColumn fx:id="colMontantTtc" prefWidth="120" text="MONTANT TTC"/>
                    <TableColumn fx:id="colDateFacture" prefWidth="130" text="DATE FACTURE"/>
                    <TableColumn fx:id="colDateEcheance" prefWidth="130" text="ÉCHÉANCE"/>
                    <TableColumn fx:id="colStatut" prefWidth="120" styleClass="column-statut" text="STATUT"/>
                    <TableColumn fx:id="colModePaiement" prefWidth="130" text="MODE PAIEMENT"/>
                    <TableColumn fx:id="colActions" prefWidth="60" styleClass="column-statut" text=""/>
                </columns>
            </TableView>

            <!-- Pagination -->
            <HBox alignment="CENTER_RIGHT" spacing="8" style="-fx-padding: 8 0 0 0;">
                <Label text="Lignes par page : " styleClass="depense-meta"/>
                <ComboBox prefWidth="70"
                          style="-fx-background-color: white; -fx-background-radius: 4; -fx-border-color: #F0E6DA; -fx-border-radius: 4;">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <Integer fx:value="10"/>
                            <Integer fx:value="25"/>
                            <Integer fx:value="50"/>
                            <Integer fx:value="100"/>
                        </FXCollections>
                    </items>
                    <value>
                        <Integer fx:value="10"/>
                    </value>
                </ComboBox>
                <HBox spacing="4">
                    <Button text="←" styleClass="btn-back" style="-fx-padding: 4 10;"/>
                    <Label text="1" style="-fx-padding: 4 10; -fx-background-color: #4F6815; -fx-text-fill: white; -fx-background-radius: 4;"/>
                    <Button text="2" style="-fx-padding: 4 10; -fx-background-color: transparent; -fx-text-fill: #333; -fx-cursor: hand; -fx-border-color: #F0E6DA; -fx-border-radius: 4;"/>
                    <Button text="→" styleClass="btn-back" style="-fx-padding: 4 10;"/>
                </HBox>
            </HBox>

        </VBox>

    </VBox>
</ScrollPane>