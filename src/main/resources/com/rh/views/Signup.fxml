<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.rh.contollers.SignupController"
            style="-fx-background-color:#F0E6DA;">

    <center>
        <ScrollPane style="-fx-background-color:#F0E6DA;-fx-background:transparent;-fx-border-color:transparent;"
                    fitToWidth="true">
            <HBox alignment="CENTER" style="-fx-background-color:#F0E6DA;">

                <!-- Card d'inscription -->
                <VBox spacing="15" alignment="CENTER"
                      style="-fx-background-color:#FFFFFF;-fx-background-radius:20;-fx-padding:30 35 30 35;"
                      prefWidth="500" maxWidth="500">

                    <!-- Logo -->
                    <VBox alignment="CENTER" spacing="4">
                        <ImageView fitWidth="150" fitHeight="55" preserveRatio="true">
                            <Image url="@../images/logo-Isobat.png"/>
                        </ImageView>
                        <Label text="Gestion RH &amp; Finance"
                               style="-fx-font-family:'Poppins';-fx-font-size:10;-fx-text-fill:#999999;"/>
                    </VBox>

                    <Separator style="-fx-background-color:#F0E6DA;"/>

                    <!-- Titre -->
                    <Label text="📝 Créer un compte"
                           style="-fx-font-family:'Poppins';-fx-font-size:20;-fx-font-weight:bold;-fx-text-fill:#1A1A1A;"/>

                    <!-- Champs du formulaire -->
                    <VBox spacing="10" fillWidth="true" maxWidth="Infinity">

                        <!-- Nom et Prénom sur la même ligne -->
                        <HBox spacing="12" fillHeight="true">
                            <VBox spacing="3" HBox.hgrow="ALWAYS">
                                <Label text="Nom *"
                                       style="-fx-font-family:'Poppins';-fx-font-size:11;-fx-font-weight:600;-fx-text-fill:#555555;"/>
                                <TextField fx:id="tfNom" promptText="Votre nom"
                                           style="-fx-font-family:'Poppins';-fx-font-size:13;-fx-padding:8 12 8 12;-fx-background-color:#FFFFFF;-fx-border-color:#E0D0BE;-fx-border-radius:8;-fx-background-radius:8;-fx-border-width:1.5;"
                                           prefHeight="38"/>
                                <Label fx:id="errNom" style="-fx-font-family:'Poppins';-fx-font-size:10;-fx-text-fill:#75070C;" text="" managed="false"/>
                            </VBox>
                            <VBox spacing="3" HBox.hgrow="ALWAYS">
                                <Label text="Prénom *"
                                       style="-fx-font-family:'Poppins';-fx-font-size:11;-fx-font-weight:600;-fx-text-fill:#555555;"/>
                                <TextField fx:id="tfPrenom" promptText="Votre prénom"
                                           style="-fx-font-family:'Poppins';-fx-font-size:13;-fx-padding:8 12 8 12;-fx-background-color:#FFFFFF;-fx-border-color:#E0D0BE;-fx-border-radius:8;-fx-background-radius:8;-fx-border-width:1.5;"
                                           prefHeight="38"/>
                                <Label fx:id="errPrenom" style="-fx-font-family:'Poppins';-fx-font-size:10;-fx-text-fill:#75070C;" text="" managed="false"/>
                            </VBox>
                        </HBox>

                        <!-- Email -->
                        <VBox spacing="3">
                            <Label text="Adresse email *"
                                   style="-fx-font-family:'Poppins';-fx-font-size:11;-fx-font-weight:600;-fx-text-fill:#555555;"/>
                            <TextField fx:id="tfEmail" promptText="exemple@domaine.com"
                                       style="-fx-font-family:'Poppins';-fx-font-size:13;-fx-padding:8 12 8 12;-fx-background-color:#FFFFFF;-fx-border-color:#E0D0BE;-fx-border-radius:8;-fx-background-radius:8;-fx-border-width:1.5;"
                                       prefHeight="38"/>
                            <Label fx:id="errEmail" style="-fx-font-family:'Poppins';-fx-font-size:10;-fx-text-fill:#75070C;" text="" managed="false"/>
                        </VBox>

                        <!-- Téléphone -->
                        <VBox spacing="3">
                            <Label text="Téléphone (optionnel)"
                                   style="-fx-font-family:'Poppins';-fx-font-size:11;-fx-font-weight:600;-fx-text-fill:#555555;"/>
                            <TextField fx:id="tfTelephone" promptText="06 12 34 56 78"
                                       style="-fx-font-family:'Poppins';-fx-font-size:13;-fx-padding:8 12 8 12;-fx-background-color:#FFFFFF;-fx-border-color:#E0D0BE;-fx-border-radius:8;-fx-background-radius:8;-fx-border-width:1.5;"
                                       prefHeight="38"/>
                            <Label fx:id="errTelephone" style="-fx-font-family:'Poppins';-fx-font-size:10;-fx-text-fill:#75070C;" text="" managed="false"/>
                        </VBox>

                        <!-- Mot de passe -->
                        <VBox spacing="3">
                            <Label text="Mot de passe *"
                                   style="-fx-font-family:'Poppins';-fx-font-size:11;-fx-font-weight:600;-fx-text-fill:#555555;"/>
                            <PasswordField fx:id="pfPassword" promptText="••••••••"
                                           style="-fx-font-family:'Poppins';-fx-font-size:13;-fx-padding:8 12 8 12;-fx-background-color:#FFFFFF;-fx-border-color:#E0D0BE;-fx-border-radius:8;-fx-background-radius:8;-fx-border-width:1.5;"
                                           prefHeight="38"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label fx:id="errPassword" style="-fx-font-family:'Poppins';-fx-font-size:10;-fx-text-fill:#75070C;" text="" managed="false" HBox.hgrow="ALWAYS"/>
                                <Label text="Minimum 6 caractères"
                                       style="-fx-font-family:'Poppins';-fx-font-size:9;-fx-text-fill:#AAAAAA;"/>
                            </HBox>
                        </VBox>

                        <!-- Confirmation mot de passe -->
                        <VBox spacing="3">
                            <Label text="Confirmer le mot de passe *"
                                   style="-fx-font-family:'Poppins';-fx-font-size:11;-fx-font-weight:600;-fx-text-fill:#555555;"/>
                            <PasswordField fx:id="pfPasswordConfirm" promptText="••••••••"
                                           style="-fx-font-family:'Poppins';-fx-font-size:13;-fx-padding:8 12 8 12;-fx-background-color:#FFFFFF;-fx-border-color:#E0D0BE;-fx-border-radius:8;-fx-background-radius:8;-fx-border-width:1.5;"
                                           prefHeight="38"/>
                            <Label fx:id="errPasswordConfirm" style="-fx-font-family:'Poppins';-fx-font-size:10;-fx-text-fill:#75070C;" text="" managed="false"/>
                        </VBox>

                    </VBox>

                    <!-- Message erreur général -->
                    <Label fx:id="lblErreur" text="" visible="false" managed="false"
                           style="-fx-font-family:'Poppins';-fx-font-size:12;-fx-text-fill:#75070C;-fx-background-color:#FFF0F0;-fx-padding:8 12 8 12;-fx-background-radius:8;"
                           wrapText="true" maxWidth="Infinity"/>

                    <!-- Boutons -->
                    <VBox spacing="8" fillWidth="true">
                        <Button fx:id="btnSignup" text="S'INSCRIRE" onAction="#handleSignup"
                                style="-fx-font-family:'Poppins';-fx-font-size:14;-fx-font-weight:bold;-fx-background-color:#4F6815;-fx-text-fill:#FFFFFF;-fx-background-radius:10;-fx-padding:11 0 11 0;-fx-cursor:hand;"
                                maxWidth="Infinity"/>
                        <HBox alignment="CENTER" spacing="5">
                            <Label text="Déjà un compte ?"
                                   style="-fx-font-family:'Poppins';-fx-font-size:11;-fx-text-fill:#888888;"/>
                            <Hyperlink text="Connectez-vous" onAction="#handleLogin"
                                       style="-fx-font-family:'Poppins';-fx-font-size:11;-fx-font-weight:bold;-fx-text-fill:#75070C;-fx-underline:false;"/>
                        </HBox>
                    </VBox>

                    <!-- Version -->
                    <Label text="v1.0.0"
                           style="-fx-font-family:'Poppins';-fx-font-size:9;-fx-text-fill:#CCCCCC;"
                           alignment="CENTER" maxWidth="Infinity"/>

                </VBox>
            </HBox>
        </ScrollPane>
    </center>

</BorderPane>