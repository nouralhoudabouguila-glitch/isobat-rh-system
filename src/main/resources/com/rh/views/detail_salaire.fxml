<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.rh.contollers.DetailSalaireController">

    <VBox spacing="24" styleClass="dashboard-root">

        <!-- ── En-tête avec retour ── -->
        <HBox alignment="CENTER_LEFT" spacing="14">
            <Button text="← Retour" styleClass="btn-back" onAction="#onRetour"/>
            <Label fx:id="lblTitre" text="💼  Détails des Salaires" styleClass="welcome-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblCentre" text="Centre : " styleClass="depense-meta" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 6 14; -fx-background-color: #e8f0d8; -fx-background-radius: 8;"/>
        </HBox>

        <!-- ── Résumé ── -->
        <HBox spacing="20" alignment="CENTER_LEFT">
            <VBox styleClass="stat-card" spacing="5" style="-fx-padding: 12 20;">
                <Label text="Total des salaires" styleClass="card-label"/>
                <Label fx:id="lblTotalGeneral" text="0,000 DT" styleClass="card-value" style="-fx-font-size: 28px; -fx-text-fill: #75070C;"/>
            </VBox>
            <VBox styleClass="stat-card" spacing="5" style="-fx-padding: 12 20;">
                <Label text="Nombre d'employés" styleClass="card-label"/>
                <Label fx:id="lblNbEmployes" text="0" styleClass="card-value" style="-fx-font-size: 28px; -fx-text-fill: #4F6815;"/>
            </VBox>
        </HBox>

        <!-- ── Tableau ── -->
        <VBox styleClass="chart-card" VBox.vgrow="ALWAYS" spacing="12">

            <!-- En-tête de la table -->
            <HBox alignment="CENTER_LEFT">
                <Label text="📋  Liste des employés" styleClass="section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="📥  Exporter" styleClass="btn-secondary"/>
                <Button text="🔄  Actualiser" styleClass="btn-back"/>
            </HBox>

            <Separator/>

            <!-- TableView -->
            <TableView fx:id="tableView" styleClass="activity-table" VBox.vgrow="ALWAYS" prefHeight="450">
                <columns>
                    <TableColumn fx:id="colNom" text="NOM ET PRÉNOM" prefWidth="250"/>
                    <TableColumn fx:id="colRib" text="RIB / NUMÉRO DE COMPTE" prefWidth="300"/>
                    <TableColumn fx:id="colMontant" text="MONTANT (DT)" prefWidth="150" styleClass="column-statut"/>
                </columns>
            </TableView>

            <!-- Total en bas du tableau -->
            <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 8 0 0 0; -fx-border-color: #F0E6DA; -fx-border-width: 1 0 0 0; -fx-padding: 12 0 0 0;">
                <Label text="TOTAL" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>
                <Label fx:id="lblTotalBas" text="0,000 DT" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #75070C;"/>
            </HBox>

        </VBox>

    </VBox>
</ScrollPane>