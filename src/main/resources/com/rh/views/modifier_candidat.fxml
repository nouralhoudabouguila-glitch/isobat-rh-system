<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.rh.contollers.ModifierCandidatController"
      spacing="20" style="-fx-background-color: #F0E6DA; -fx-padding: 25 30 25 30;"
      prefWidth="600" prefHeight="650">

    <!-- Titre -->
    <Label text="✏️  Modifier un candidat" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;"/>

    <Separator/>

    <!-- Formulaire -->
    <VBox spacing="15">

        <!-- Ligne 1: Nom et Prénom -->
        <HBox spacing="20">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Nom *" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
                <TextField fx:id="txtNom" promptText="Entrez le nom"
                           style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 10 14; -fx-border-color: #F0E6DA; -fx-border-radius: 8;"/>
            </VBox>
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Prénom *" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
                <TextField fx:id="txtPrenom" promptText="Entrez le prénom"
                           style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 10 14; -fx-border-color: #F0E6DA; -fx-border-radius: 8;"/>
            </VBox>
        </HBox>

        <!-- Ligne 2: Téléphone -->
        <VBox spacing="5">
            <Label text="Téléphone *" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
            <TextField fx:id="txtTelephone" promptText="Ex: 52800489"
                       style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 10 14; -fx-border-color: #F0E6DA; -fx-border-radius: 8;"/>
        </VBox>

        <!-- Ligne 3: Poste -->
        <VBox spacing="5">
            <Label text="Poste *" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
            <TextField fx:id="txtPoste" promptText="Ex: Téléopérateur"
                       style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 10 14; -fx-border-color: #F0E6DA; -fx-border-radius: 8;"/>
        </VBox>

        <!-- Ligne 4: Expérience -->
        <VBox spacing="5">
            <Label text="Expérience" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
            <TextArea fx:id="txtExperience" promptText="Décrivez l'expérience du candidat..."
                      prefHeight="80" wrapText="true"
                      style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 10 14; -fx-border-color: #F0E6DA; -fx-border-radius: 8;"/>
        </VBox>

        <!-- Ligne 5: Commentaire -->
        <VBox spacing="5">
            <Label text="Commentaire" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
            <TextArea fx:id="txtCommentaire" promptText="Ajoutez un commentaire..."
                      prefHeight="60" wrapText="true"
                      style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 10 14; -fx-border-color: #F0E6DA; -fx-border-radius: 8;"/>
        </VBox>

        <!-- Ligne 6: Statut -->
        <VBox spacing="5">
            <Label text="Statut" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
            <ComboBox fx:id="comboStatut"
                      style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 8 12; -fx-border-color: #F0E6DA; -fx-border-radius: 8; -fx-pref-height: 40;"
                      prefWidth="200"/>
        </VBox>

        <!-- Champs obligatoires -->
        <Label text="* Champs obligatoires" style="-fx-font-size: 11px; -fx-text-fill: #888888;"/>

    </VBox>

    <!-- Boutons -->
    <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 20 0 0 0;">
        <Button fx:id="btnAnnuler" text="Annuler" styleClass="btn-back" onAction="#onAnnuler"/>
        <Button fx:id="btnModifier" text="Modifier" styleClass="btn-primary" onAction="#onModifier"/>
    </HBox>

</VBox>