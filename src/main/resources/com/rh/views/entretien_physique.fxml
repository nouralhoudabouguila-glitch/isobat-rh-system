<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.collections.FXCollections?>

<?import java.lang.Integer?>
<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.rh.contollers.EntretienPhysiqueController">

    <VBox styleClass="dashboard-root" spacing="20">

        <!-- ── En-tête ── -->
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="🤝  Entretien Physique" styleClass="welcome-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="＋  Ajouter un entretien" styleClass="btn-primary"/>
            <Button text="📥  Exporter" styleClass="btn-secondary"/>
        </HBox>

        <!-- ── Filtres / Recherche ── -->
        <HBox spacing="12" alignment="CENTER_LEFT">
            <TextField promptText="🔍  Rechercher un candidat..."
                       style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 8 14; -fx-border-color: #F0E6DA; -fx-border-radius: 8;"
                       prefWidth="300"/>
            <ComboBox promptText="Filtrer par statut"
                      style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 4 8; -fx-border-color: #F0E6DA; -fx-border-radius: 8; -fx-pref-height: 36;"/>
            <Button text="Filtrer" styleClass="btn-secondary"/>
            <Button text="Réinitialiser" styleClass="btn-back"/>
        </HBox>

        <!-- ── Statistiques rapides ── -->
        <HBox spacing="15">
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="5" style="-fx-padding: 12 18;">
                <Label text="Total" styleClass="card-label"/>
                <Label fx:id="lblTotalCandidats" text="0" styleClass="card-value" style="-fx-font-size: 22px;"/>
            </VBox>
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="5" style="-fx-padding: 12 18; -fx-border-color: #4F6815; -fx-border-width: 2;">
                <Label text="Retenus" styleClass="card-label"/>
                <Label text="0" styleClass="card-value" style="-fx-font-size: 22px; -fx-text-fill: #4F6815;"/>
            </VBox>
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="5" style="-fx-padding: 12 18; -fx-border-color: #75070C; -fx-border-width: 2;">
                <Label text="Absents" styleClass="card-label"/>
                <Label text="0" styleClass="card-value" style="-fx-font-size: 22px; -fx-text-fill: #75070C;"/>
            </VBox>
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="5" style="-fx-padding: 12 18; -fx-border-color: #FFEDAB; -fx-border-width: 2;">
                <Label text="Reportés" styleClass="card-label"/>
                <Label text="0" styleClass="card-value" style="-fx-font-size: 22px; -fx-text-fill: #7a5c00;"/>
            </VBox>
        </HBox>

        <!-- ── Tableau ── -->
        <VBox styleClass="chart-card" VBox.vgrow="ALWAYS" spacing="12">

            <!-- En-tête de la table -->
            <HBox alignment="CENTER_LEFT">
                <Label text="📋  Liste des entretiens physiques" styleClass="section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="12 entretien(s)" styleClass="depense-meta"/>
            </HBox>

            <Separator/>

            <!-- TableView -->
            <TableView fx:id="tableView" styleClass="activity-table" VBox.vgrow="ALWAYS" prefHeight="450">
                <columns>
                    <TableColumn fx:id="colNom" text="NOM &amp; PRÉNOM" prefWidth="250"/>
                    <TableColumn fx:id="colDateRdv" text="DATE RDV" prefWidth="200"/>
                    <TableColumn fx:id="colPoste" text="POSTE" prefWidth="200"/>
                    <TableColumn fx:id="colStatut" text="STATUT" prefWidth="200" styleClass="column-statut"/>
                </columns>
            </TableView>

            <!-- Pagination -->
            <HBox alignment="CENTER_RIGHT" spacing="8" style="-fx-padding: 8 0 0 0;">
                <Label text="Lignes par page : " styleClass="depense-meta"/>
                <ComboBox prefWidth="70"
                          style="-fx-background-color: white; -fx-background-radius: 4; -fx-border-color: #F0E6DA; -fx-border-radius: 4;">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <Integer fx:value="10"/>
                            <Integer fx:value="25"/>
                            <Integer fx:value="50"/>
                            <Integer fx:value="100"/>
                        </FXCollections>
                    </items>
                    <value>
                        <Integer fx:value="10"/>
                    </value>
                </ComboBox>
                <HBox spacing="4">
                    <Button text="←" styleClass="btn-back" style="-fx-padding: 4 10;"/>
                    <Label text="1" style="-fx-padding: 4 10; -fx-background-color: #4F6815; -fx-text-fill: white; -fx-background-radius: 4;"/>
                    <Button text="2" style="-fx-padding: 4 10; -fx-background-color: transparent; -fx-text-fill: #333; -fx-cursor: hand; -fx-border-color: #F0E6DA; -fx-border-radius: 4;"/>
                    <Button text="→" styleClass="btn-back" style="-fx-padding: 4 10;"/>
                </HBox>
            </HBox>

        </VBox>

    </VBox>
</ScrollPane>