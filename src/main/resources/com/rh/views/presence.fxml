<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.rh.contollers.PresenceController"
            style="-fx-background-color:#FAF6F0;">

    <top>
        <VBox spacing="14" style="-fx-padding:20 28 14 28;">

            <!-- Titre -->
            <VBox spacing="2">
                <Label text="📊 Gestion des Présences"
                       style="-fx-font-family:'Manrope';-fx-font-size:22;-fx-font-weight:bold;-fx-text-fill:#2A2A2A;"/>
                <Label text="Suivi des pointages, import Excel et statistiques"
                       style="-fx-font-family:'Manrope';-fx-font-size:12;-fx-text-fill:#999999;"/>
            </VBox>

            <!-- Barre d'outils -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <DatePicker fx:id="dpDate" promptText="Date"
                            style="-fx-font-family:'Manrope';-fx-font-size:12;-fx-background-radius:8;-fx-border-radius:8;-fx-border-color:#E0D0BE;-fx-padding:6 12 6 12;"/>

                <ComboBox fx:id="cbDepartement" prefWidth="150"
                          style="-fx-font-family:'Manrope';-fx-font-size:12;-fx-background-radius:8;"/>

                <ComboBox fx:id="cbStatut" prefWidth="140"
                          style="-fx-font-family:'Manrope';-fx-font-size:12;-fx-background-radius:8;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="📥 Importer Excel" onAction="#handleImporter"
                        style="-fx-font-family:'Manrope';-fx-font-size:12;-fx-font-weight:bold;-fx-background-color:#4F6815;-fx-text-fill:#FFFFFF;-fx-background-radius:8;-fx-padding:9 18 9 18;-fx-cursor:hand;"/>

                <Button text="🔄 Actualiser" onAction="#handleRefresh"
                        style="-fx-font-family:'Manrope';-fx-font-size:12;-fx-font-weight:bold;-fx-background-color:#75070C;-fx-text-fill:#FFFFFF;-fx-background-radius:8;-fx-padding:9 18 9 18;-fx-cursor:hand;"/>

                <Label fx:id="lblCount" text="0 présence(s)"
                       style="-fx-font-family:'Manrope';-fx-font-size:11;-fx-text-fill:#999999;"/>
            </HBox>

            <!-- KPI -->
            <HBox spacing="12">
                <VBox spacing="2" style="-fx-background-color:#FFFFFF;-fx-background-radius:10;-fx-padding:10 16 10 16;-fx-border-color:#E0D0BE;-fx-border-radius:10;-fx-border-width:1;">
                    <Label text="Présents" style="-fx-font-family:'Manrope';-fx-font-size:10;-fx-text-fill:#666666;"/>
                    <Label fx:id="kpiPresent" text="0" style="-fx-font-family:'Manrope';-fx-font-size:18;-fx-font-weight:bold;-fx-text-fill:#4F6815;"/>
                </VBox>
                <VBox spacing="2" style="-fx-background-color:#FFFFFF;-fx-background-radius:10;-fx-padding:10 16 10 16;-fx-border-color:#E0D0BE;-fx-border-radius:10;-fx-border-width:1;">
                    <Label text="Retards" style="-fx-font-family:'Manrope';-fx-font-size:10;-fx-text-fill:#666666;"/>
                    <Label fx:id="kpiRetard" text="0" style="-fx-font-family:'Manrope';-fx-font-size:18;-fx-font-weight:bold;-fx-text-fill:#C8A000;"/>
                </VBox>
                <VBox spacing="2" style="-fx-background-color:#FFFFFF;-fx-background-radius:10;-fx-padding:10 16 10 16;-fx-border-color:#E0D0BE;-fx-border-radius:10;-fx-border-width:1;">
                    <Label text="Absents" style="-fx-font-family:'Manrope';-fx-font-size:10;-fx-text-fill:#666666;"/>
                    <Label fx:id="kpiAbsent" text="0" style="-fx-font-family:'Manrope';-fx-font-size:18;-fx-font-weight:bold;-fx-text-fill:#75070C;"/>
                </VBox>
                <VBox spacing="2" style="-fx-background-color:#FFFFFF;-fx-background-radius:10;-fx-padding:10 16 10 16;-fx-border-color:#E0D0BE;-fx-border-radius:10;-fx-border-width:1;">
                    <Label text="Total" style="-fx-font-family:'Manrope';-fx-font-size:10;-fx-text-fill:#666666;"/>
                    <Label fx:id="kpiTotal" text="0" style="-fx-font-family:'Manrope';-fx-font-size:18;-fx-font-weight:bold;-fx-text-fill:#1A1A1A;"/>
                </VBox>
            </HBox>

        </VBox>
    </top>

    <center>
        <VBox style="-fx-padding:0 28 24 28;">
            <TableView fx:id="tablePresence" VBox.vgrow="ALWAYS"
                       style="-fx-background-color:transparent;-fx-font-family:'Manrope';">
                <columns>
                    <TableColumn fx:id="colEmploye" text="Employé" prefWidth="180"/>
                    <TableColumn fx:id="colDepartement" text="Département" prefWidth="140"/>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="100"/>
                    <TableColumn fx:id="colArrivee" text="Arrivée" prefWidth="80"/>
                    <TableColumn fx:id="colDebutPause" text="Début Pause" prefWidth="90"/>
                    <TableColumn fx:id="colFinPause" text="Fin Pause" prefWidth="90"/>
                    <TableColumn fx:id="colDepart" text="Départ" prefWidth="80"/>
                    <TableColumn fx:id="colHeures" text="Heures" prefWidth="80"/>
                    <TableColumn fx:id="colStatut" text="Statut" prefWidth="120"/>
                    <TableColumn fx:id="colSource" text="Source" prefWidth="100"/>
                    <TableColumn fx:id="colActions" text="Actions" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>