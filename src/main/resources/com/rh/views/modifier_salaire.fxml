<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.rh.contollers.ModifierSalaireController"
      spacing="20" style="-fx-background-color: #F0E6DA; -fx-padding: 25 30 25 30;"
      prefWidth="450" prefHeight="380">

    <!-- Titre -->
    <Label text="✏️  Modifier le salaire" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;"/>
    <Separator/>

    <VBox spacing="15">
        <!-- Nom (lecture seule) -->
        <VBox spacing="5">
            <Label text="Employé" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
            <TextField fx:id="txtNom" editable="false"
                       style="-fx-background-color: #f0f0f0; -fx-background-radius: 8; -fx-padding: 10 14; -fx-border-color: #E0D8D0; -fx-border-radius: 8;"/>
        </VBox>

        <!-- RIB (lecture seule) -->
        <VBox spacing="5">
            <Label text="RIB / Numéro de compte" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
            <TextField fx:id="txtRib" editable="false"
                       style="-fx-background-color: #f0f0f0; -fx-background-radius: 8; -fx-padding: 10 14; -fx-border-color: #E0D8D0; -fx-border-radius: 8;"/>
        </VBox>

        <!-- Montant (modifiable) -->
        <VBox spacing="5">
            <Label text="Montant (DT) *" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
            <TextField fx:id="txtMontant" promptText="Ex: 2500,00"
                       style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 10 14; -fx-border-color: #F0E6DA; -fx-border-radius: 8;"/>
            <Label text="Format: Utilisez la virgule ou le point comme séparateur décimal"
                   style="-fx-font-size: 10px; -fx-text-fill: #888888;"/>
        </VBox>

        <Label text="* Champs obligatoires" style="-fx-font-size: 11px; -fx-text-fill: #888888;"/>
    </VBox>

    <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 20 0 0 0;">
        <Button fx:id="btnAnnuler" text="Annuler" styleClass="btn-back" onAction="#onAnnuler"/>
        <Button fx:id="btnModifier" text="Modifier" styleClass="btn-primary" onAction="#onModifier"/>
    </HBox>
</VBox>