<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
    conges.fxml
    Vue principale du module Congés — tableau des demandes + KPI + filtres.
    Contrôleur : com.rh.contollers.CongesController
-->
<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.rh.contollers.CongesController"
            style="-fx-background-color:#FAF6F0;">

    <!-- ════════════════════════════ HEADER ════════════════════════════ -->
    <top>
        <VBox spacing="18" style="-fx-padding:24 28 18 28;">

            <!-- Titre -->
            <VBox spacing="2">
                <Label text="Gestion des Congés"
                       style="-fx-font-family:'Poppins';-fx-font-size:22;-fx-font-weight:bold;-fx-text-fill:#2A2A2A;"/>
                <Label text="Suivi des demandes et soldes — 18 jours annuels"
                       style="-fx-font-family:'Poppins';-fx-font-size:12;-fx-text-fill:#999999;"/>
            </VBox>

            <!-- Cartes KPI -->
            <HBox spacing="14">
                <VBox spacing="4" HBox.hgrow="ALWAYS"
                      style="-fx-background-color:#FFFBEE;-fx-background-radius:12;-fx-padding:14 20 14 20;-fx-border-color:#F0E2C0;-fx-border-radius:12;-fx-border-width:1;">
                    <Label text="EN ATTENTE"
                           style="-fx-font-family:'Poppins';-fx-font-size:10;-fx-font-weight:bold;-fx-text-fill:#C8A000;"/>
                    <Label fx:id="kpiAttente" text="0"
                           style="-fx-font-family:'Poppins';-fx-font-size:24;-fx-font-weight:bold;-fx-text-fill:#C8A000;"/>
                </VBox>

                <VBox spacing="4" HBox.hgrow="ALWAYS"
                      style="-fx-background-color:#F0F5E8;-fx-background-radius:12;-fx-padding:14 20 14 20;-fx-border-color:#DCEAC2;-fx-border-radius:12;-fx-border-width:1;">
                    <Label text="APPROUVÉS"
                           style="-fx-font-family:'Poppins';-fx-font-size:10;-fx-font-weight:bold;-fx-text-fill:#4F6815;"/>
                    <Label fx:id="kpiApprouve" text="0"
                           style="-fx-font-family:'Poppins';-fx-font-size:24;-fx-font-weight:bold;-fx-text-fill:#4F6815;"/>
                </VBox>

                <VBox spacing="4" HBox.hgrow="ALWAYS"
                      style="-fx-background-color:#FFF0F0;-fx-background-radius:12;-fx-padding:14 20 14 20;-fx-border-color:#F5D2D2;-fx-border-radius:12;-fx-border-width:1;">
                    <Label text="REFUSÉS"
                           style="-fx-font-family:'Poppins';-fx-font-size:10;-fx-font-weight:bold;-fx-text-fill:#75070C;"/>
                    <Label fx:id="kpiRefuse" text="0"
                           style="-fx-font-family:'Poppins';-fx-font-size:24;-fx-font-weight:bold;-fx-text-fill:#75070C;"/>
                </VBox>

                <VBox spacing="4" HBox.hgrow="ALWAYS"
                      style="-fx-background-color:#FFFFFF;-fx-background-radius:12;-fx-padding:14 20 14 20;-fx-border-color:#EAE0D2;-fx-border-radius:12;-fx-border-width:1;">
                    <Label text="TOTAL"
                           style="-fx-font-family:'Poppins';-fx-font-size:10;-fx-font-weight:bold;-fx-text-fill:#854F0B;"/>
                    <Label fx:id="kpiTotal" text="0"
                           style="-fx-font-family:'Poppins';-fx-font-size:24;-fx-font-weight:bold;-fx-text-fill:#854F0B;"/>
                </VBox>
            </HBox>

            <!-- Barre recherche / filtres / nouvelle demande -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="tfSearch" promptText="Rechercher un employé ou un poste..."
                           prefWidth="280"
                           style="-fx-font-family:'Poppins';-fx-font-size:12;-fx-background-radius:8;-fx-border-radius:8;-fx-border-color:#E0D0BE;-fx-padding:8 12 8 12;"/>

                <ComboBox fx:id="cbFilterType" prefWidth="160"
                          style="-fx-font-family:'Poppins';-fx-font-size:12;-fx-background-radius:8;"/>

                <ComboBox fx:id="cbFilterStatut" prefWidth="150"
                          style="-fx-font-family:'Poppins';-fx-font-size:12;-fx-background-radius:8;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="lblCount" text="0 demande(s)"
                       style="-fx-font-family:'Poppins';-fx-font-size:11;-fx-text-fill:#999999;"/>

                <Button text="＋ Nouvelle demande" onAction="#handleAdd"
                        style="-fx-font-family:'Poppins';-fx-font-size:12;-fx-font-weight:bold;-fx-background-color:#75070C;-fx-text-fill:#FFFFFF;-fx-background-radius:8;-fx-padding:9 18 9 18;-fx-cursor:hand;"/>
            </HBox>

        </VBox>
    </top>

    <!-- ════════════════════════════ TABLEAU ════════════════════════════ -->
    <center>
        <VBox style="-fx-padding:0 28 24 28;">
            <TableView fx:id="tableConges" VBox.vgrow="ALWAYS"
                       style="-fx-background-color:transparent;-fx-font-family:'Poppins';">
                <columns>
                    <TableColumn fx:id="colNom" text="Employé" prefWidth="150"/>
                    <TableColumn fx:id="colPoste" text="Poste" prefWidth="110"/>
                    <TableColumn fx:id="colType" text="Type" prefWidth="120"/>
                    <TableColumn fx:id="colDebut" text="Début" prefWidth="90"/>
                    <TableColumn fx:id="colFin" text="Fin" prefWidth="90"/>
                    <TableColumn fx:id="colNbJours" text="Jours" prefWidth="60"/>
                    <TableColumn fx:id="colInitial" text="Solde init." prefWidth="80"/>
                    <TableColumn fx:id="colConsomme" text="Consommé" prefWidth="85"/>
                    <TableColumn fx:id="colRestant" text="Restant" prefWidth="75"/>
                    <TableColumn fx:id="colStatut" text="Statut" prefWidth="110"/>
                    <TableColumn fx:id="colRemplacant" text="Remplaçant" prefWidth="110"/>
                    <TableColumn fx:id="colCommentaire" text="Commentaire" prefWidth="160"/>
                    <TableColumn fx:id="colActions" text="Actions" prefWidth="110"/>
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>